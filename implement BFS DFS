#Implementing Uninformed Search Strategies
#To implement and compare Breadth-First Search (BFS) and Depth-First Search (DFS).

from collections import deque

graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}

def bfs(start):
    visited = set()
    queue = deque([start])
    order = []

    while queue:
        node = queue.popleft()

        if node not in visited:
            visited.add(node)
            order.append(node)

            for neighbor in graph[node]:
                if neighbor not in visited:
                    queue.append(neighbor)

    return order

def dfs(start):
    visited = set()
    stack = [start]
    order = []

    while stack:
        node = stack.pop()

        if node not in visited:
            visited.add(node)
            order.append(node)

            for neighbor in reversed(graph[node]):
                if neighbor not in visited:
                    stack.append(neighbor)

    return order

print("BFS Traversal:", bfs('A'))
print("DFS Traversal:", dfs('A'))

#Explanation
#The graph dictionary represents the graph and its connections.
#bfs(start) performs Breadth-First Search.
#BFS uses a queue, which follows First In, First Out (FIFO).
#dfs(start) performs Depth-First Search.
#DFS uses a stack, which follows Last In, First Out (LIFO).
#The visited set prevents nodes from being processed repeatedly.
#The order list stores the order in which nodes are visited.
#Both functions return their traversal sequences.
